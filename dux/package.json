{
  "name": "h3-dux-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "description": "Maintainer workspace for @mszr/h3-dux",
  "workspaces": [
    "h3-dux",
    "h3-dux/demo",
    "h3-dux/demo/nitro"
  ],
  "scripts": {
    "postinstall": "bun scripts/install-git-hooks.ts --optional",
    "git:hooks:install": "bun scripts/install-git-hooks.ts",
    "upi": "bunx npm-check-updates -i",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "val": "bun run validate",

    "sdk:dev": "bun --cwd=h3-dux run stub",
    "sdk:lint": "eslint ./h3-dux/src",
    "sdk:lint:fix": "eslint ./h3-dux/src --fix",
    "sdk:typecheck": "bun --cwd=h3-dux run typecheck",
    "sdk:test": "bun --cwd=h3-dux run test",
    "sdk:test:watch": "bun --cwd=h3-dux run test:watch",
    "sdk:build:upstream": "cd .. && pnpm install --silent && pnpm build",
    "sdk:build:ours": "rm -rf h3-dux/dist && bun --cwd=h3-dux run build",
    "sdk:build:all": "bun run sdk:build:upstream && bun run sdk:build:ours"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "^1.3.0",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.6.1",
    "turbo": "^2.6.2",
    "typescript": "^6.0.3"
  }
}
