{
  "name": "h3-dux-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Maintainer workspace for @mszr/h3-dux",
  "workspaces": [
    "h3-dux",
    "sandbox/demo-main/standalone",
    "sandbox/demo-main/nitro",
    "sandbox/demo-comparisons/fixtures",
    "sandbox/demo-comparisons/*/standalone",
    "sandbox/demo-comparisons/*/standalone/client",
    "sandbox/demo-comparisons/*/nitro",
    "sandbox/demo-comparisons/*/nitro/client"
  ],
  "scripts": {
    "postinstall": "bun scripts/install-git-hooks.ts --optional",
    "git:hooks:install": "bun scripts/install-git-hooks.ts",
    "upi": "bunx npm-check-updates -i",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "val": "bun run validate",

    "sdk:dev": "cd h3-dux && bun x obuild --stub",
    "sdk:lint": "eslint ./h3-dux/src",
    "sdk:lint:fix": "eslint ./h3-dux/src --fix",
    "sdk:typecheck": "cd h3-dux && bun x tsc --noEmit",
    "sdk:test": "cd h3-dux && bun x vitest run --typecheck --passWithNoTests",
    "sdk:test:watch": "cd h3-dux && bun x vitest --typecheck",
    "sdk:build:upstream": "cd .. && pnpm install --silent && pnpm build",
    "sdk:build:ours": "rm -rf h3-dux/dist && cd h3-dux && bun x obuild",
    "sdk:build:all": "bun run sdk:build:upstream && bun run sdk:build:ours",

    "prepublish:verify": "bun scripts/publish/prepublish-verify.ts",
    "publish:sdk:dry-run": "bun scripts/publish/publish-sdk.ts --dry-run",
    "publish:sdk:patch": "bun scripts/publish/publish-sdk.ts patch",
    "publish:sdk:minor": "bun scripts/publish/publish-sdk.ts minor",
    "publish:sdk:major": "bun scripts/publish/publish-sdk.ts major",
    "publish:subtree:squash": "bun scripts/publish/publish-subtree.ts",

    "demo:main:standalone": "bun --cwd=sandbox/demo-main/standalone run trip",
    "demo:main:standalone:serve": "bun --cwd=sandbox/demo-main/standalone run serve",
    "demo:main:nitro": "bun --cwd=sandbox/demo-main/nitro run dev",

    "demo:comparisons:h3:standalone": "bun --cwd=sandbox/demo-comparisons/h3/standalone/client run dev",
    "demo:comparisons:h3:standalone:serve": "bun --cwd=sandbox/demo-comparisons/h3/standalone run dev",
    "demo:comparisons:h3:nitro": "bun --cwd=sandbox/demo-comparisons/h3/nitro/client run dev",
    "demo:comparisons:h3:nitro:serve": "bun --cwd=sandbox/demo-comparisons/h3/nitro run build && bun --cwd=sandbox/demo-comparisons/h3/nitro run start",

    "demo:comparisons:h3-dux:standalone": "bun --cwd=sandbox/demo-comparisons/h3-dux/standalone/client run dev",
    "demo:comparisons:h3-dux:standalone:serve": "bun --cwd=sandbox/demo-comparisons/h3-dux/standalone run dev",
    "demo:comparisons:h3-dux:nitro": "bun --cwd=sandbox/demo-comparisons/h3-dux/nitro/client run dev",
    "demo:comparisons:h3-dux:nitro:serve": "bun --cwd=sandbox/demo-comparisons/h3-dux/nitro run build && bun --cwd=sandbox/demo-comparisons/h3-dux/nitro run start",

    "demo:comparisons:hono:standalone": "bun --cwd=sandbox/demo-comparisons/hono/standalone/client run dev",
    "demo:comparisons:hono:standalone:serve": "bun --cwd=sandbox/demo-comparisons/hono/standalone run dev",
    "demo:comparisons:hono:nitro": "bun --cwd=sandbox/demo-comparisons/hono/nitro/client run dev",
    "demo:comparisons:hono:nitro:serve": "bun --cwd=sandbox/demo-comparisons/hono/nitro run build && bun --cwd=sandbox/demo-comparisons/hono/nitro run start",

    "demo:comparisons:elysia:standalone": "bun --cwd=sandbox/demo-comparisons/elysia/standalone/client run dev",
    "demo:comparisons:elysia:standalone:serve": "bun --cwd=sandbox/demo-comparisons/elysia/standalone run dev",
    "demo:comparisons:elysia:nitro": "bun --cwd=sandbox/demo-comparisons/elysia/nitro/client run dev",
    "demo:comparisons:elysia:nitro:serve": "bun --cwd=sandbox/demo-comparisons/elysia/nitro run build && bun --cwd=sandbox/demo-comparisons/elysia/nitro run start"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "^1.3.14",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.7.0",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
