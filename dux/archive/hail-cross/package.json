{
  "name": "hail-cross",
  "version": "0.0.0",
  "private": true,
  "description": "🍊 Orchard — one fruit-market API, six backends and six type-safe clients, for comparing Elysia / h3 / Hono ergonomics (standalone and under Nitro).",
  "workspaces": [
    "packages/*",
    "playground/backends/*",
    "playground/backends/nitro/*",
    "playground/clients/*",
    "playground/clients/nitro/*"
  ],
  "type": "module",
  "scripts": {
    "upi": "bunx npm-check-updates -i",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "val": "bun run validate"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "^1.3.0",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.6.1",
    "turbo": "^2.6.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13"
}
